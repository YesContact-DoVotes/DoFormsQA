# AI QA Agent Configuration

# Default LLM Provider: codex, openai, gemini
DEFAULT_LLM_PROVIDER=codex

# OpenAI Settings (for GPT-4o / GPT-4o-mini / OpenRouter / Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=low

# Gemini Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Browser Automation
DEFAULT_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800
ACTION_TIMEOUT_MS=8000

# SQLite / Postgres Database URL
DATABASE_URL=sqlite+aiosqlite:///storage/qa_agent.db
